# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments / caches
.venv
.uv-cache

# Data & experiment outputs (large / regenerable)
data/raw/
data/splits/
outputs/
**/data/raw/
**/data/splits/
**/outputs/

# Data v2: images/tarballs/arrays are regenerable; manifest.json and
# leakage_report.json stay tracked.
data/v2/images/
data/v2/*.tar
data/v2/*.npy

# Run outputs (results/runs.jsonl is tracked, caches are not)
runs/
results/cache/
*.onnx
*.onnx.data

# Jupyter
.ipynb_checkpoints/

# Secrets
.kaggle/
**/kaggle.json
.env
.env.*

# OS / editor
.DS_Store
*.swp
data/web_holdout_v1/images/
# Regenerable: contact sheets from tools/build_dataset_v2.py (the CSVs beside them are tracked) and the head stamp
# from src/compclass/final.py.
data/v2/review/*.jpg
exports/final/*.head_sha256

# Small report inputs; generic runs/ above excludes training outputs elsewhere.
!results/itri626/runs/
!results/itri626/runs/*.json

# Rust (cargo workspace; also an app's own target/ from before the workspace)
target/
