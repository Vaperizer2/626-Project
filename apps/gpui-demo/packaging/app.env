# The app's identity for packaging: sourced by run.sh, run-nixos.sh and scripts/package_linux.sh (POSIX sh).
# Keep it in step with src/app.rs (NAME, TITLE, ENV_PREFIX) and the binary name in Cargo.toml.
#   APP_NAME    folder names: the bundle (<APP_NAME>-linux-x86_64) and ~/.cache/<APP_NAME>
#   APP_TITLE   the name people read
#   ENV_PREFIX  the app's environment variables: <ENV_PREFIX>_MODELS, _DEMO_DIR, _GPU, _GPU_VENV
#   BIN         the executable in the bundle
APP_NAME=component-classifier
APP_TITLE="Component Classifier"
ENV_PREFIX=COMPCLASS
BIN=gpui-demo
